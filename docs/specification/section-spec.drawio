        <UserObject id="balances-home" label="← К дереву" link="data:page/id,map">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#A54628;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;">
            <mxGeometry x="1280" y="30" width="260" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-title" label="Остаток товара: готов только фундамент">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=32;fontColor=#202320;spacing=0;fontStyle=1;">
            <mxGeometry x="60" y="95" width="1480" height="55" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-sub" label="STK-01…06 · таблица есть, законченного пользовательского сценария пока нет">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-01" label="STK-01 · Разделение данных" requirement-id="STK-01" status="partial" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E5D3B6;swimlaneFillColor=#FAF7F1;strokeColor=#AB7843;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-01-status" label="ЧАСТИЧНО · завершённого сценария нет">
          <mxCell vertex="1" parent="balances-STK-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#AB7843;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Product — название, артикул, единица; StockBalance — текущее количество.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Связь по product_id → products.id; не по SKU и не по quantity.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;БД: внешний ключ и уникальный индекс product_id.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка данных: нельзя создать два остатка для одного товара или ссылку на несуществующий товар.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="balances-STK-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-02" label="STK-02 · Количество и границы" requirement-id="STK-02" status="partial" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E5D3B6;swimlaneFillColor=#FAF7F1;strokeColor=#AB7843;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-02-status" label="ЧАСТИЧНО · завершённого сценария нет">
          <mxCell vertex="1" parent="balances-STK-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#AB7843;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;quantity: decimal(12,3), NOT NULL, DEFAULT 0.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Модель и CHECK БД запрещают quantity &amp;lt; 0; ноль разрешён.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Модельные тесты отрицательного и нулевого количества проходят.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка будущего API: точные десятичные значения сохраняются без Float-погрешностей.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Запрет дробных «шт» ещё не согласован и не реализован.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="balances-STK-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-03" label="STK-03 · Товар и нулевой остаток" requirement-id="STK-03" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="585" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-03-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="balances-STK-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Нужно создать Product и его StockBalance(0) в одной транзакции.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Сейчас has_one описывает связь, но не создаёт строку автоматически.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Если сохранение остатка не удалось, товар также не должен остаться в БД.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: успешное создание → две связанные записи; искусственная ошибка → ни одной.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Для старых товаров потребуется отдельное безопасное заполнение отсутствующих остатков.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="balances-STK-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-04" label="STK-04 · Чтение остатков" requirement-id="STK-04" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="585" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-04-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="balances-STK-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Рабочего API чтения/изменения остатков пока нет.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Требование: показать пользователю актуальное количество и единицу товара.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Отсутствующая строка остатка не должна автоматически отображаться как 0.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: нет ложного остатка; потеря связи или недоступность API даёт явное состояние.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Маршрут, DTO и размещение экрана нужно определить до реализации.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="balances-STK-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-05" label="STK-05 · Согласованность с журналом" requirement-id="STK-05" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="960" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-05-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="balances-STK-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Текущий остаток и движение сохраняются в одной транзакции.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Изменение количества не должно обходить запись истории.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: сбой любого сохранения откатывает оба изменения.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;После операций сумма начального остатка и всех delta должна совпадать с текущим остатком.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="balances-STK-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-06" label="STK-06 · Конкурентный доступ" requirement-id="STK-06" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="960" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-06-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="balances-STK-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-STK-06-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Строка StockBalance блокируется до чтения остатка и проверки списания.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Применить блокировку БД внутри транзакции, например Rails with_lock.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Второй запрос ждёт и проверяет уже обновлённое количество.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: при 10 кг и двух одновременных списаниях по 7 кг проходит только одно; остаток 3 кг.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="balances-STK-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="balances-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1330" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
