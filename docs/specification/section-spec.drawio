        </UserObject>
        <UserObject id="history-MOV-01" label="MOV-01 · Запись движения" requirement-id="MOV-01" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-01-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="history-MOV-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Предлагаемые поля: product_id, operator_id, signed delta, kind, created_at, reason/destination.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;delta &amp;gt; 0 — приход; delta &amp;lt; 0 — списание; изменение остатка связано с записью.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Время и оператор назначаются сервером, а не принимаются на доверии от клиента.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: каждая подтверждённая операция имеет одну запись с полным основанием.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="history-MOV-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-02" label="MOV-02 · Неизменяемость" requirement-id="MOV-02" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-02-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="history-MOV-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Завершённые движения не редактируются и не удаляются обычными операциями.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Ошибку исправляет отдельная компенсирующая/корректирующая запись.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: история позволяет объяснить текущий остаток; прошлое действие не исчезает.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Окончательные ограничения модели и БД нужно спроектировать.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="history-MOV-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-03" label="MOV-03 · Просмотр и фильтрация" requirement-id="MOV-03" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="555" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-03-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="history-MOV-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Будущий журнал: товар, тип, количество, оператор, время, назначение.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Предусмотреть пагинацию и фильтры товара/периода/типа.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: пользователь может проследить изменение конкретного товара без загрузки всего журнала.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;API, порядок сортировки, фильтры и права просмотра пока не утверждены.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="history-MOV-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-04" label="MOV-04 · Куда и откуда" requirement-id="MOV-04" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="555" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-04-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="history-MOV-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;В исходном сценарии требуется фиксировать назначение списания и источник прихода.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;На первом этапе допустимо согласованное текстовое основание операции.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Справочник контрагентов упоминался в раннем M0, но модели/API в текущем коде нет.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Не вводить сложный документооборот только ради поля назначения.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Выбор текста или справочника — открытое решение.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="history-MOV-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-05" label="MOV-05 · Будущие контрагенты" requirement-id="MOV-05" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="890" width="720" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-05-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="history-MOV-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;После подтверждения области: отдельный справочник поставщиков/получателей.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Возможная связь движения с контрагентом; исторические записи должны сохранять смысл.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Нужно согласовать поля, обязательность, архивирование и права.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;До этого контрагенты не учитываются как реализованная часть проекта.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="history-MOV-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="history-MOV-06" label="MOV-06 · Сверка и аудит" requirement-id="MOV-06" status="plan" qa="not-run" baseline="ced61fb">
