        <UserObject id="acceptance-DOC-04-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="acceptance-DOC-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
