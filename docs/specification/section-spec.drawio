  <diagram id="catalog" name="06 · Каталог">
    <mxGraphModel dx="1600" dy="1415" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1420" math="0" shadow="0" background="#F3EFE7">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="catalog-brand" label="СЕКЦИЯ / ТЕХНИЧЕСКОЕ ЗАДАНИЕ">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=0;strokeColor=none;fillColor=#202320;fontColor=#F3EFE7;fontSize=15;fontStyle=1;align=left;spacingLeft=18;">
            <mxGeometry x="60" y="30" width="1080" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-home" label="← К дереву" link="data:page/id,map">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#A54628;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;">
            <mxGeometry x="1280" y="30" width="260" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-title" label="Карточки и создание товаров">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=32;fontColor=#202320;spacing=0;fontStyle=1;">
            <mxGeometry x="60" y="95" width="1480" height="55" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-sub" label="CAT-01…06 · данные каталога не равны складскому остатку">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-01" label="CAT-01 · Просмотр каталога" requirement-id="CAT-01" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-01-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="catalog-CAT-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;GET /products возвращает список, GET /products/:id — один товар.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Оба запроса доступны активным operator и admin.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Карточки и таблица показывают одинаковые записи из API.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: пустая база даёт понятное пустое состояние; сбой — ошибку и возможность повторить.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="catalog-CAT-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-02" label="CAT-02 · Создание товара" requirement-id="CAT-02" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-02-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="catalog-CAT-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;POST /products; JSON product: sku, name, unit.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;При успехе 201 и созданный товар; UI перечитывает список.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: после создания запись сохраняется в БД, видна после перезагрузки и доступна по id.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Сейчас создание товара не создаёт связанный StockBalance — это отдельная незавершённая задача.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="catalog-CAT-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-03" label="CAT-03 · Обязательные поля и единицы" requirement-id="CAT-03" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="575" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-03-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="catalog-CAT-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;name и sku обязательны; unit допускает только «шт» или «кг».&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Пустая строка и nil отклоняются моделью; ошибка → 422, errors[].&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;UI использует select, но API также обязан отклонять «г», «т», «pcs».&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: отрицательные кейсы проверяются по одному, с остальными корректными полями.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="catalog-CAT-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-04" label="CAT-04 · Уникальность артикула" requirement-id="CAT-04" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="575" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-04-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="catalog-CAT-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Модель validates uniqueness + уникальный индекс products.sku.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Обычный дубль → 422; нарушение индекса при гонке → управляемый 409.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: повторный SKU не увеличивает Product.count; заполненная форма остаётся.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Параллельные запросы: в БД не появляется два одинаковых SKU.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="catalog-CAT-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-05" label="CAT-05 · Изображения и стандартные позиции" requirement-id="CAT-05" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="900" width="720" height="370" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-05-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="catalog-CAT-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Фото — типовые иллюстрации, не точная техническая спецификация артикула.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Явное соответствие: BOLT-M8 — болт; DOWEL-8 — дюбель; SCR-4.5 — прямой чёрный саморез.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Другие SKU получают общую иллюстрацию; угадывания по словам в названии нет.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Демо-задача добавляет три позиции без перезаписи существующих.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: сломанные картинки/выдуманные цены, остатки и размеры отсутствуют.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="catalog-CAT-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="240" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-06" label="CAT-06 · Нормализация и развитие каталога" requirement-id="CAT-06" status="gap" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#EBD4C4;swimlaneFillColor=#FAF7F1;strokeColor=#AC6341;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="900" width="720" height="370" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-06-status" label="ОТКРЫТЫЙ ПРОБЕЛ · требует решения">
          <mxCell vertex="1" parent="catalog-CAT-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#AC6341;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-CAT-06-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Сейчас SKU не обрезается и не приводится к единому регистру.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Правило для BOLT-M8 / bolt-m8 и пробелов нужно согласовать; UI не меняет его самостоятельно.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;В БД name/sku/unit пока допускают NULL; обязательность обеспечивает модель.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Редактирование, архивирование, удаление, загрузка фото, категории и серверный поиск не реализованы.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка будущего изменения: единые правила в UI, модели, миграциях и обработке старых данных.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="catalog-CAT-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="240" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1350" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-prev" label="← Предыдущая" link="data:page/id,administration">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1120" y="1340" width="200" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="catalog-next" label="Следующая →" link="data:page/id,balances">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1340" y="1340" width="200" height="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
