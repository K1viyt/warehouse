        </UserObject>
        <UserObject id="operations-OPS-01" label="OPS-01 · Приход" requirement-id="OPS-01" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-01-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="operations-OPS-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Ввод: товар, положительное количество, источник/основание операции.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Оператор определяется сервером по текущей сессии.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Под блокировкой увеличить остаток и добавить положительное движение.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: 10 кг + 2,5 кг → 12,5 кг; одна запись истории, один подтверждённый результат.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;API и интерфейс пока не реализованы.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="operations-OPS-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-02" label="OPS-02 · Списание" requirement-id="OPS-02" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-02-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="operations-OPS-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Ввод: товар, количество &amp;gt; 0, назначение/куда списали.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Под блокировкой проверить quantity &amp;lt;= доступного остатка.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Уменьшить остаток и добавить отрицательное движение в общей транзакции.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: 10 кг − 3 кг → 7 кг; видны оператор, время, назначение и количество.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="operations-OPS-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-03" label="OPS-03 · Недостаточный остаток" requirement-id="OPS-03" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="585" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-03-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="operations-OPS-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Если запрос превышает доступное количество, не менять БД.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Ответ должен сообщать актуальный доступный остаток и понятную причину.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: при 10 кг попытка списать 12 кг не меняет остаток и не создаёт движение.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Код отказа и формат ошибки согласовать вместе с контрактом API.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="operations-OPS-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-04" label="OPS-04 · Некорректные данные" requirement-id="OPS-04" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="585" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-04-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="operations-OPS-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Отклонять ноль, отрицательное количество, нечисловой ввод и несуществующий товар.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Единица берётся из Product; клиент не может переопределить её для операции.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Проверить лимит decimal и число знаков после запятой.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: ошибочный запрос не оставляет частичных записей.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Политику округления и дробных штук требуется согласовать.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="operations-OPS-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-05" label="OPS-05 · Повторное нажатие и повтор запроса" requirement-id="OPS-05" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="920" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-05-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="operations-OPS-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;UI блокирует повторную отправку на время запроса.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;На сервере нужен согласованный ключ/идентификатор операции для защиты от дубля.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Повтор той же операции не должен повторно изменять остаток.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: два одинаковых запроса с одним идентификатором → одно движение.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Точный формат ключа и срок хранения пока не определены.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="operations-OPS-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-06" label="OPS-06 · Коррекция и права" requirement-id="OPS-06" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="920" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-06-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="operations-OPS-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-OPS-06-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Коррекция отражается отдельным движением с причиной, а не скрытым изменением остатка.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Исправление не должно делать остаток отрицательным или стирать прошлую операцию.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Предлагается ограничить коррекцию администратором — решение ещё не утверждено.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка будущего сценария: известны автор, причина и связь с исправляемой операцией.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Права прихода/списания/коррекции необходимо подтвердить до разработки.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="operations-OPS-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="operations-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1340" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
