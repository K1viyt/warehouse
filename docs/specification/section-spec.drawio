          <mxCell vertex="1" parent="access-8" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=14;fontStyle=1;">
            <mxGeometry x="24" y="60" width="952" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="access-8-body" label="&lt;div style=&quot;line-height:1.4&quot;&gt;Две одинаковые учётные записи сохранить нельзя. Понятный отказ при одновременной регистрации одной почты ещё требует доработки.&lt;/div&gt;">
