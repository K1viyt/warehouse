          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontColor=#202320;spacing=0;">
