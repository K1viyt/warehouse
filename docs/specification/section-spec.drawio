            <mxGeometry x="820" y="950" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-06-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="quality-NFR-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
