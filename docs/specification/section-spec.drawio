        </UserObject>
        <UserObject id="acceptance-DOC-02-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="acceptance-DOC-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-DOC-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;«Реализовано» означает наличие поведения в коде, а не принятие тестером.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;QA отмечает Passed / Failed / Blocked / Not run с версией и доказательством.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Блок принят, когда выполнены его обязательные критерии и нет блокирующих дефектов.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Процент допустим только как доля заранее определённого списка проверок; здесь проценты не назначались.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="acceptance-DOC-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-DOC-03" label="DOC-03 · Источники и трассируемость" requirement-id="DOC-03" status="policy" qa="not-run" baseline="ced61fb">
