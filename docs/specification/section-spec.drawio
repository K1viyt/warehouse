          </mxCell>
        </UserObject>
        <UserObject id="administration-sub" label="ADM-01…06 · только активный администратор">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-01" label="ADM-01 · Общий список" requirement-id="ADM-01" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-01-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="administration-ADM-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;GET /admin/users возвращает users[] и pagination.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Поля пользователя: id, name, email_address, role, status, created_at.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Порядок: id по возрастанию; список ожидающих отдельно сортируется по created_at.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: operator получает 403, гость 401; хеш пароля не попадает в JSON.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="administration-ADM-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-02" label="ADM-02 · Фильтрация и страницы" requirement-id="ADM-02" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-02-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="administration-ADM-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;status фильтрует пользователей до подсчёта total.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;page не меньше 1; per_page ограничен диапазоном 1…100, по умолчанию 20.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;UI запрашивает по 10 строк, показывает total и число страниц.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: вторая страница не дублирует первую; смена фильтра начинает с первой.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Пустой/вышедший за диапазон список не приводит к падению интерфейса.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="administration-ADM-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-03" label="ADM-03 · Активация" requirement-id="ADM-03" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="565" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-03-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="administration-ADM-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;PATCH /admin/users/:id/activate разрешает pending → active.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;active/blocked → 409; неизвестный пользователь → 404.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: после 200 пользователь исчезает из ожидающих и получает доступ к каталогу.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Повторная активация не должна менять данные или возвращать 500.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="administration-ADM-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-04" label="ADM-04 · Блокировка" requirement-id="ADM-04" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="565" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-04-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="administration-ADM-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;PATCH /admin/users/:id/block разрешает active → blocked.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;pending, уже blocked и аккаунт admin → 409; неизвестный id → 404.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: администратор не может заблокировать администратора.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Ранее вошедший заблокированный оператор теряет доступ на следующем запросе.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="administration-ADM-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-05" label="ADM-05 · Разблокировка" requirement-id="ADM-05" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="890" width="720" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-05-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="administration-ADM-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;PATCH /admin/users/:id/unblock разрешает blocked → active.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;pending/active → 409; неизвестный id → 404.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: оператор снова может войти; фильтр заблокированных обновляется.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Активация и разблокировка — разные действия, кнопки соответствуют статусу.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="administration-ADM-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-06" label="ADM-06 · Первый администратор" requirement-id="ADM-06" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="890" width="720" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-06-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="administration-ADM-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-ADM-06-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;db/seeds.rb использует email/password из переменных окружения.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Начальные роль и статус: admin/active; пароль хранится как password_digest.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Нет публичной регистрации с выбором роли; секреты не включаются в диаграммы и репозиторий.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: после подготовки окружения есть активный администратор для активации заявок.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="administration-ADM-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="administration-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1280" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
