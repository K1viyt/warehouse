  <diagram id="administration" name="05 · Администрирование">
    <mxGraphModel dx="1600" dy="1345" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1350" math="0" shadow="0" background="#F3EFE7">
