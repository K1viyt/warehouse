          <mxCell vertex="1" parent="receipt-5" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=14;fontStyle=1;">
            <mxGeometry x="24" y="60" width="952" height="28" as="geometry" />
