          <mxCell vertex="1" parent="receipt-3" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontSize=14;fontStyle=1;">
