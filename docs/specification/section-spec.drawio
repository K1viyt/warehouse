            </Array>
          </mxGeometry>
        </mxCell>
        <UserObject id="receipt-5" label="Кто и когда выполнил приход">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=48;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#F8D8D5;swimlaneFillColor=#FFFDFA;strokeColor=#BB3E37;strokeWidth=2;fontSize=21;fontStyle=1;align=left;spacingLeft=24;spacingRight=18;">
