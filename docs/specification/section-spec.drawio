        </UserObject>
        <UserObject id="receipt-4-body" label="&lt;div style=&quot;line-height:1.4&quot;&gt;Успешный приход увеличивает остаток ровно на указанное количество. Например: было 10 кг, поступило 2,5 кг — стало 12,5 кг.&lt;/div&gt;">
