        <UserObject id="quality-sub" label="NFR-01…06 · применяются ко всем реализуемым сценариям">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-01" label="NFR-01 · Дизайн и читаемость" requirement-id="NFR-01" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-01-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="quality-NFR-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Индустриальная концепция «СЕКЦИЯ»: угольный, тёплый каменный, медный акцент.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Реалистичный склад со стеллажами/палетами/погрузчиком на страницах доступа.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Предметные фото крепежа; прямой саморез; данные на спокойных поверхностях.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: читаемые подписи, контраст, нет перекрытий и мультяшных заглушек.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="quality-NFR-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-02" label="NFR-02 · Адаптивность и управление" requirement-id="NFR-02" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-02-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="quality-NFR-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Проверить широкий экран и ширину 390 px; страница не прокручивается горизонтально.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Таблицы при необходимости прокручиваются внутри контейнера.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Нативный dialog: фокус внутри, Escape закрывает, фокус возвращается к открывшей кнопке.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Есть видимый фокус, подписи полей, текстовые ошибки; reduced-motion отключает анимацию.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Полный аудит доступности независимым тестером ещё не выполнен.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="quality-NFR-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-03" label="NFR-03 · Честные состояния формы" requirement-id="NFR-03" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="605" width="720" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-03-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="quality-NFR-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Загрузка, ошибка, пустой список, успех и отказ доступа имеют отдельное отображение.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Успех только после ответа API; поля не теряются при ошибке.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;204 обрабатывается без JSON.parse; не-JSON ответ и сетевой сбой не выглядят как успех.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: повторное действие возможно после отказа; двойной запрос блокируется.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="quality-NFR-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-04" label="NFR-04 · Сессия и CSRF" requirement-id="NFR-04" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="605" width="720" height="310" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-04-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="quality-NFR-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Сессионная cookie; изменения данных требуют действующий CSRF-токен.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;GET /interface/csrf возвращает токен текущей сессии; ответ no-store.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Пароли и токены не сохраняются в localStorage и не публикуются в исходниках.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: запрос без токена отвергается; после сброса сессии повторный вход работает.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="quality-NFR-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-05" label="NFR-05 · Данные и разграничение прав" requirement-id="NFR-05" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="950" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-05-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="quality-NFR-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Защита выполняется сервером, даже если кнопка скрыта.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Текст пользователя экранируется; сообщения ошибок вставляются как текст.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Пароль хранится через has_secure_password/password_digest, не возвращается API.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: HTML в названии не выполняется; подмена роли/статуса не повышает права.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="quality-NFR-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="quality-NFR-06" label="NFR-06 · Организация и воспроизводимость" requirement-id="NFR-06" status="ready" qa="not-run" baseline="ced61fb">
