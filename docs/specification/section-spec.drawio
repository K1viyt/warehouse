  <diagram id="decisions" name="16 · План и решения">
    <mxGraphModel dx="1600" dy="1365" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1370" math="0" shadow="0" background="#F3EFE7">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="decisions-brand" label="СЕКЦИЯ / ТЕХНИЧЕСКОЕ ЗАДАНИЕ">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=0;strokeColor=none;fillColor=#202320;fontColor=#F3EFE7;fontSize=15;fontStyle=1;align=left;spacingLeft=18;">
            <mxGeometry x="60" y="30" width="1080" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-home" label="← К дереву" link="data:page/id,map">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#A54628;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;">
            <mxGeometry x="1280" y="30" width="260" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-title" label="Что делать дальше и что требуется решить">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=32;fontColor=#202320;spacing=0;fontStyle=1;">
            <mxGeometry x="60" y="95" width="1480" height="55" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-sub" label="Дорожная карта: зависимости важнее произвольных процентов">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-01" label="DEC-01 · P0 · Перед независимой приёмкой" requirement-id="DEC-01" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-01-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="decisions-DEC-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Тестер получает feature/frontend-warehouse-ui, поднимает собственное окружение.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Создать/использовать администратора через переменные окружения и seeds.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Пройти QA-01…QA-26; дефекты оформить с шагами, ожиданием, фактом и версией.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Особое внимание: отказ доступа, сохранение формы, дубли, повторное чтение записи.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Назначения исполнителей и сроки команда определяет отдельно.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="decisions-DEC-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-02" label="DEC-02 · P1 · Закрыть фундамент остатков" requirement-id="DEC-02" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-02-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="decisions-DEC-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Транзакционное создание товара и StockBalance(0).&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Безопасно заполнить отсутствующие остатки у старых товаров.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Добавить API чтения и согласовать DTO; затем сделать UI остатков.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Критерий перехода: нет товара без корректной строки остатка в выбранном режиме учёта.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="decisions-DEC-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-03" label="DEC-03 · P2 · Приход, списание, журнал" requirement-id="DEC-03" status="plan" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E2DDD3;swimlaneFillColor=#FAF7F1;strokeColor=#918B7D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="565" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-03-status" label="ПЛАН · API и UI пока нет">
          <mxCell vertex="1" parent="decisions-DEC-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#918B7D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Сначала модель движения и атомарный приход одной позиции.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Затем списание с блокировкой, отказом при недостатке и идемпотентностью.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;После этого просмотр истории, корректировка и необходимые права.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Тесты параллельных запросов и отката — обязательны до демонстрации операций.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="decisions-DEC-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-04" label="DEC-04 · Открытые правила данных" requirement-id="DEC-04" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="565" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-04-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="decisions-DEC-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;SKU: регистр, пробелы, исправление артикула и совместимость со старыми данными.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Количество: дробные штуки, точность, округление, предел ввода.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Почта: серверная проверка формата; пароль: минимальная политика.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Начальные остатки: источник, импорт и отражение в истории.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Не выдавать предположения за утверждённые требования.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="decisions-DEC-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-05" label="DEC-05 · Открытые роли и контракты" requirement-id="DEC-05" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="900" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-05-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="decisions-DEC-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Кто может выполнять приход, списание и коррекцию?&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Нужно ли обязательное назначение/источник и достаточно ли текстового поля?&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Нужен ли справочник контрагентов в ближайшей итерации?&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Согласовать маршруты, DTO, коды отказа и идемпотентность будущих операций.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;До решения не добавлять фиктивные эндпоинты в публичное API.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="decisions-DEC-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-06" label="DEC-06 · Пробелы текущей реализации" requirement-id="DEC-06" status="gap" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#EBD4C4;swimlaneFillColor=#FAF7F1;strokeColor=#AC6341;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="900" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-06-status" label="ОТКРЫТЫЙ ПРОБЕЛ · требует решения">
          <mxCell vertex="1" parent="decisions-DEC-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#AC6341;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-DEC-06-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Backend-формат email и конкурентный дубль регистрации ещё требуют доработки.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Обязательность Product-полей пока только в модели, не NOT NULL в БД.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Нормализация SKU не согласована; архивация/редактирование/фото не реализованы.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;bin/brakeman требует обновления версии: установленный 8.0.6 дал 0 предупреждений, обёртка --ensure-latest отказалась.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Эти ограничения фиксируются отдельно от подтверждённых сценариев.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="decisions-DEC-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1300" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-prev" label="← Предыдущая" link="data:page/id,qa-stock">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1120" y="1290" width="200" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="decisions-next" label="Следующая →" link="data:page/id,acceptance">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1340" y="1290" width="200" height="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="acceptance" name="17 · Приёмка и источники">
    <mxGraphModel dx="1600" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1030" math="0" shadow="0" background="#F3EFE7">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="acceptance-brand" label="СЕКЦИЯ / ТЕХНИЧЕСКОЕ ЗАДАНИЕ">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=0;strokeColor=none;fillColor=#202320;fontColor=#F3EFE7;fontSize=15;fontStyle=1;align=left;spacingLeft=18;">
            <mxGeometry x="60" y="30" width="1080" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-home" label="← К дереву" link="data:page/id,map">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#A54628;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;">
            <mxGeometry x="1280" y="30" width="260" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-title" label="Как читать, проверять и обновлять ТЗ">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=32;fontColor=#202320;spacing=0;fontStyle=1;">
            <mxGeometry x="60" y="95" width="1480" height="55" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-sub" label="DOC-01…04 · один источник требований, отдельное подтверждение результата">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-DOC-01" label="DOC-01 · Работа с деревом" requirement-id="DOC-01" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-DOC-01-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="acceptance-DOC-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-DOC-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;На странице 00 нажмите «Открыть требования» для перехода к модулю.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Значок −/+ на ветви сворачивает/раскрывает её краткое описание.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Вверху каждой страницы есть «К дереву», внизу — переходы между страницами.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Номер требования сохраняется при правках; ссылки ведут к разделу, где оно описано.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Для чтения без редактора предусмотрены PDF и HTML-просмотр.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="acceptance-DOC-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="acceptance-DOC-02" label="DOC-02 · Статус приёмки" requirement-id="DOC-02" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="300" as="geometry" />
