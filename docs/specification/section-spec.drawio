        </UserObject>
        <UserObject id="passport-BASE-02-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="passport-BASE-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Роли: operator — оператор; admin — администратор.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Статусы аккаунта: pending, active, blocked.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Активные operator и admin могут просматривать и создавать товары.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Только активный admin управляет пользователями.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: смена статуса не меняет роль; оператор не получает админ-права.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="passport-BASE-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-03" label="BASE-03 · Матрица доступа" requirement-id="BASE-03" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="575" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-03-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="passport-BASE-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Гость: регистрация и вход; каталог и /me → 401.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;pending: вход и свой профиль разрешены; каталог и админ-API → 403.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;active operator: каталог, создание товара, свой профиль; админ-API → 403.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;active admin: те же действия + управление пользователями.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;blocked: вход → 403; ранее выданная сессия сбрасывается при защищённом запросе.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="passport-BASE-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-04" label="BASE-04 · За пределами текущей итерации" requirement-id="BASE-04" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="575" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-04-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="passport-BASE-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Не включены: несколько складов, партии, штрихкоды, резервирование, цены и финансовый учёт.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Redis и отдельный React/SPA не требуются для текущих сценариев.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Редактирование, архивирование, удаление и фото товаров не имеют готовых API.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Сложные накладные и согласование документов не возвращаем в облегчённый сценарий.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: макеты и демонстрация не выдают эти функции за реализованные.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="passport-BASE-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-05" label="BASE-05 · Смысл отметок готовности" requirement-id="BASE-05" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="930" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-05-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="passport-BASE-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Есть: поведение найдено в коде; это не означает принятие тестером.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Частично: реализована только часть требования или слой данных.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;План: требование следующей итерации, рабочего API/интерфейса нет.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Разработчик: автоматические/ручные проверки, указанные в ТЗ.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;QA: везде ожидает независимой приёмки; проценты готовности не выдумываются.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="passport-BASE-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-06" label="BASE-06 · Основание и актуальность" requirement-id="BASE-06" status="policy" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#E7E1D6;swimlaneFillColor=#FAF7F1;strokeColor=#A09A8D;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="930" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-06-status" label="КОНТЕКСТ / ПРАВИЛО · не результат QA">
          <mxCell vertex="1" parent="passport-BASE-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#A09A8D;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-BASE-06-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Снимок: 15.10.2026; код интерфейса ced61fb, основа моделей 39da1a1.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Ветка: feature/frontend-warehouse-ui; опубликована в GitHub K1viyt/warehouse.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Проверены routes, контроллеры, модели, schema и docs/frontend.md.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Последний прогон разработчика: 48 тестов / 212 проверок; ошибок нет.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;После изменения кода статусы и критерии необходимо пересмотреть; это не постоянная гарантия.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="passport-BASE-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1330" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="passport-prev" label="← Предыдущая" link="data:page/id,map">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1120" y="1320" width="200" height="40" as="geometry" />
