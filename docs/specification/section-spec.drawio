        </UserObject>
        <UserObject id="passport-next" label="Следующая →" link="data:page/id,registration">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1340" y="1320" width="200" height="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="registration" name="02 · Регистрация">
    <mxGraphModel dx="1600" dy="1405" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1410" math="0" shadow="0" background="#F3EFE7">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="registration-brand" label="СЕКЦИЯ / ТЕХНИЧЕСКОЕ ЗАДАНИЕ">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=0;strokeColor=none;fillColor=#202320;fontColor=#F3EFE7;fontSize=15;fontStyle=1;align=left;spacingLeft=18;">
            <mxGeometry x="60" y="30" width="1080" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-home" label="← К дереву" link="data:page/id,map">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#A54628;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;">
            <mxGeometry x="1280" y="30" width="260" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-title" label="Регистрация и заявка на доступ">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=32;fontColor=#202320;spacing=0;fontStyle=1;">
            <mxGeometry x="60" y="95" width="1480" height="55" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-sub" label="ACC-01…06 · текущий контракт и ещё не закрытые ограничения">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-01" label="ACC-01 · Состав заявки" requirement-id="ACC-01" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-01-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="registration-ACC-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-01-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Ввод: name, email_address, password, password_confirmation.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;POST /registrations; корневой объект JSON — user.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Имя, почта и пароль обязательны; UI требует подтверждение; сервер проверяет его при передаче.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: успешный запрос создаёт ровно одного пользователя, возвращает 201.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Контроль: пароль и password_digest отсутствуют в ответе.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="registration-ACC-01" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-02" label="ACC-02 · Начальные права" requirement-id="ACC-02" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-02-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="registration-ACC-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-02-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Новый аккаунт получает role=operator, status=pending.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Переданные клиентом admin/active игнорируются strong parameters.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Сразу после регистрации UI показывает «Заявка принята» и переход ко входу.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: через подмену JSON нельзя активировать себя или повысить роль.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Проверить защищённый API прямым запросом, а не только отсутствие кнопки.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="registration-ACC-02" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-03" label="ACC-03 · Почта: нормализация и уникальность" requirement-id="ACC-03" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="585" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-03-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="registration-ACC-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-03-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Модель обрезает пробелы по краям email и приводит его к нижнему регистру.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Уникальность проверяется моделью и уникальным индексом в БД.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Повторная почта, включая другой регистр, → 422 и errors[].&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;UI: «Пользователь с такой почтой уже есть в системе».&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: повторный запрос не увеличивает User.count; пароль не нормализуется.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="registration-ACC-03" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-04" label="ACC-04 · Ошибка и повторная отправка" requirement-id="ACC-04" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="585" width="720" height="300" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-04-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="registration-ACC-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-04-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Несовпадающие пароли показывают текст ошибки; поля остаются заполненными.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Во время запроса кнопка отправки отключена; успех только после ответа 201.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Сетевой сбой/ошибка сервера не должны выглядеть как успешная регистрация.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: исправление поля и повторная отправка работают; двойной клик не отправляет две заявки.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="registration-ACC-04" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-05" label="ACC-05 · Формат почты и политика пароля" requirement-id="ACC-05" status="gap" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#EBD4C4;swimlaneFillColor=#FAF7F1;strokeColor=#AC6341;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="920" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-05-status" label="ОТКРЫТЫЙ ПРОБЕЛ · требует решения">
          <mxCell vertex="1" parent="registration-ACC-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#AC6341;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-05-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Сейчас браузер использует type=email; в модели отдельной проверки формата email нет.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Минимальная длина/сложность пароля бизнес-правилами не согласованы.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Нужно определить правила и обеспечить одинаковую проверку в UI и API.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка будущей доработки: неверный email/пароль отвергается прямым API-запросом, а не только браузером.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Это открытое требование, не подтверждённая готовность.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="registration-ACC-05" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-06" label="ACC-06 · Одновременная регистрация одной почты" requirement-id="ACC-06" status="gap" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#EBD4C4;swimlaneFillColor=#FAF7F1;strokeColor=#AC6341;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="920" width="720" height="340" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-06-status" label="ОТКРЫТЫЙ ПРОБЕЛ · требует решения">
          <mxCell vertex="1" parent="registration-ACC-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#AC6341;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-ACC-06-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Уникальный индекс не позволяет сохранить два одинаковых email.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Сейчас RegistrationsController не перехватывает RecordNotUnique.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Требование: конкурентный дубль должен давать управляемую ошибку без 500.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка будущей доработки: два параллельных запроса → одна запись; второй получает согласованный 409/422.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Не считать обычный тест повтора почты проверкой этой гонки.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="registration-ACC-06" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="210" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1340" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-prev" label="← Предыдущая" link="data:page/id,passport">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1120" y="1330" width="200" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="registration-next" label="Следующая →" link="data:page/id,sessions">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#E7E1D6;strokeColor=#B8B1A5;fontSize=13;">
            <mxGeometry x="1340" y="1330" width="200" height="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sessions" name="03 · Вход и профиль">
    <mxGraphModel dx="1600" dy="1345" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1350" math="0" shadow="0" background="#F3EFE7">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject id="sessions-brand" label="СЕКЦИЯ / ТЕХНИЧЕСКОЕ ЗАДАНИЕ">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=0;strokeColor=none;fillColor=#202320;fontColor=#F3EFE7;fontSize=15;fontStyle=1;align=left;spacingLeft=18;">
            <mxGeometry x="60" y="30" width="1080" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-home" label="← К дереву" link="data:page/id,map">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;rounded=1;arcSize=10;fillColor=#A54628;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;">
            <mxGeometry x="1280" y="30" width="260" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-title" label="Сессия, профиль и ожидание">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=32;fontColor=#202320;spacing=0;fontStyle=1;">
            <mxGeometry x="60" y="95" width="1480" height="55" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-sub" label="ACC-07…12 · состояние доступа после реального ответа сервера">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="155" width="1480" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-07" label="ACC-07 · Вход" requirement-id="ACC-07" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-07-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="sessions-ACC-07" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-07-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;POST /session; JSON login: email_address, password.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Правильный пароль для active/pending → 200, новая сессия с user_id.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Неверные данные → 401 «Неверная почта или пароль».&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;blocked → 403 «Доступ заблокирован».&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: email в верхнем регистре/с пробелами работает; пароль проверяется без изменения.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="sessions-ACC-07" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-08" label="ACC-08 · Ожидание активации" requirement-id="ACC-08" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="230" width="720" height="320" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-08-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="sessions-ACC-08" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-08-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;pending может войти, но видит экран ожидания, а не каталог.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;«Проверить статус» вызывает GET /me; UI учитывает статус из ответа.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;До активации защищённые товары и админ-API возвращают 403.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;После активации повторная проверка открывает каталог.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: обновление страницы не обходит ограничения и не теряет аккаунт.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="sessions-ACC-08" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-09" label="ACC-09 · Собственный профиль" requirement-id="ACC-09" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="585" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-09-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="sessions-ACC-09" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-09-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;GET /me возвращает id, name, email_address, role, status.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Гость → 401; blocked → 403 и сброс сессии.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;На экране: имя, почта, роль и статус; редактирования профиля нет.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: пароль/хеш не отображаются; профиль соответствует текущему пользователю.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="sessions-ACC-09" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-10" label="ACC-10 · Выход" requirement-id="ACC-10" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="585" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-10-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="sessions-ACC-10" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-10-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;DELETE /session сбрасывает сессию и возвращает 204 без тела.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Клиент не пытается разобрать пустой ответ как JSON.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;После выхода GET /me и каталог → 401.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: повторный вход работает; защищённые действия недоступны после выхода.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="sessions-ACC-10" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-11" label="ACC-11 · Блокировка открытой сессии" requirement-id="ACC-11" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="60" y="910" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-11-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="sessions-ACC-11" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-11-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;Если пользователь заблокирован после входа, следующий защищённый запрос возвращает 403.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Сервер сбрасывает сессию; UI переводит на вход с понятным сообщением.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Следующий GET /me → 401.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: повторный вход другим активным аккаунтом возможен без CSRF-ошибки.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="sessions-ACC-11" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-12" label="ACC-12 · Восстановление интерфейса" requirement-id="ACC-12" status="ready" qa="not-run" baseline="ced61fb">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;swimlane;startSize=60;horizontal=1;rounded=1;arcSize=8;collapsible=0;fillColor=#D8DFCE;swimlaneFillColor=#FAF7F1;strokeColor=#768462;fontSize=18;fontStyle=1;align=left;spacingLeft=18;spacingRight=18;">
            <mxGeometry x="820" y="910" width="720" height="290" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-12-status" label="ЕСТЬ · проверено разработчиком · QA ожидает">
          <mxCell vertex="1" parent="sessions-ACC-12" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#768462;spacing=0;fontStyle=1;">
            <mxGeometry x="20" y="75" width="680" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-ACC-12-body" label="&lt;div style='font-size:15px;line-height:1.4'&gt;&lt;p style='margin:0 0 9px 0'&gt;При загрузке страницы UI получает текущего пользователя через GET /me.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Маршрут #users у оператора не открывает администрирование.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Во время загрузки показан явный индикатор, а не фиктивные данные.&lt;/p&gt;&lt;p style='margin:0 0 9px 0'&gt;Приёмка: перезагрузка, переход между разделами и назад/вперёд не обходят права.&lt;/p&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="sessions-ACC-12" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#202320;spacing=0;">
            <mxGeometry x="20" y="115" width="680" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="sessions-source" label="Снимок 15.10.2026 · код ced61fb · QA-приёмка не выполнена">
          <mxCell vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#202320;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#625F57;spacing=0;">
            <mxGeometry x="60" y="1280" width="1060" height="30" as="geometry" />
          </mxCell>
        </UserObject>
