              <mxPoint x="960" y="425" />
              <mxPoint x="960" y="972.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <UserObject id="purchase-root" label="&lt;div style=&quot;text-align:left;line-height:1.2&quot;&gt;&lt;div style=&quot;font-size:23px&quot;&gt;&lt;b&gt;Потребность и закупка&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;margin-top:7px&quot;&gt;Целевая функция и текущая готовность&lt;/div&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F8DFDA;strokeColor=#AE4037;strokeWidth=2;align=left;verticalAlign=middle;spacing=20;">
            <mxGeometry x="710" y="300" width="500" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="purchase-1" label="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;div style=&quot;font-size:13px;color:#AE4037&quot;&gt;&lt;b&gt;НЕ РЕАЛИЗОВАНО&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin-top:7px&quot;&gt;&lt;b&gt;Определение потребности&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;margin-top:8px&quot;&gt;Оператор проверяет доступность в своей фирме. При отсутствии или нехватке материалов создаёт заявку на закупку для своего склада.&lt;/div&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F8DFDA;strokeColor=#AE4037;strokeWidth=2;align=left;verticalAlign=middle;spacing=20;">
            <mxGeometry x="60" y="450" width="850" height="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="purchase-2" label="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;div style=&quot;font-size:13px;color:#AE4037&quot;&gt;&lt;b&gt;НЕ РЕАЛИЗОВАНО&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin-top:7px&quot;&gt;&lt;b&gt;Состав заявки&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;margin-top:8px&quot;&gt;В заявке фиксируются склад, товары, количества и основание. Разные артикулы идут отдельными строками. Одинаковый товар при одинаковых условиях предлагается объединять суммой количества.&lt;/div&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F8DFDA;strokeColor=#AE4037;strokeWidth=2;align=left;verticalAlign=middle;spacing=20;">
            <mxGeometry x="1010" y="450" width="850" height="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="purchase-3" label="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;div style=&quot;font-size:13px;color:#AE4037&quot;&gt;&lt;b&gt;НЕ РЕАЛИЗОВАНО&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin-top:7px&quot;&gt;&lt;b&gt;Решение по закупке&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;margin-top:8px&quot;&gt;Кто согласует заявку, выбирает поставщика и оформляет заказ, нужно определить. Эти полномочия не назначаются автоматически ответственному за склад.&lt;/div&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F8DFDA;strokeColor=#AE4037;strokeWidth=2;align=left;verticalAlign=middle;spacing=20;">
            <mxGeometry x="60" y="665" width="850" height="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="purchase-4" label="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;div style=&quot;font-size:13px;color:#AE4037&quot;&gt;&lt;b&gt;НЕ РЕАЛИЗОВАНО&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin-top:7px&quot;&gt;&lt;b&gt;Заказ не равен приходу&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;margin-top:8px&quot;&gt;Создание или согласование заказа поставщику не меняет остаток. Материалы учитываются на складе только после фактического приёма.&lt;/div&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F8DFDA;strokeColor=#AE4037;strokeWidth=2;align=left;verticalAlign=middle;spacing=20;">
            <mxGeometry x="1010" y="665" width="850" height="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="purchase-5" label="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;div style=&quot;font-size:13px;color:#AE4037&quot;&gt;&lt;b&gt;НЕ РЕАЛИЗОВАНО&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin-top:7px&quot;&gt;&lt;b&gt;Приём поставки&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;margin-top:8px&quot;&gt;Полученная поставка связывается с заявкой или заказом и проводится как приход. Частичные поставки, цены и документы поставщика требуют уточнения объёма.&lt;/div&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F8DFDA;strokeColor=#AE4037;strokeWidth=2;align=left;verticalAlign=middle;spacing=20;">
            <mxGeometry x="60" y="880" width="850" height="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="purchase-6" label="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;div style=&quot;font-size:13px;color:#AE4037&quot;&gt;&lt;b&gt;НЕ РЕАЛИЗОВАНО&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin-top:7px&quot;&gt;&lt;b&gt;Смета перевозки&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;margin-top:8px&quot;&gt;Расчёт стоимости перевозки — отдельная функция от заявки на перемещение. Нужность цен, тарифов и согласования сметы вынесена на обсуждение.&lt;/div&gt;&lt;/div&gt;">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F8DFDA;strokeColor=#AE4037;strokeWidth=2;align=left;verticalAlign=middle;spacing=20;">
            <mxGeometry x="1010" y="880" width="850" height="185" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
