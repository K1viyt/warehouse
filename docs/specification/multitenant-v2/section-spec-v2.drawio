        </mxCell>
        <mxCell id="edge-5" edge="1" parent="1" source="receipt-root" target="receipt-6" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#A39A8B;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0;entryY=0.5;">
