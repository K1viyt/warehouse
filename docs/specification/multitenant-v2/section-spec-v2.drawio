        <UserObject id="legend-green" label="ГОТОВО">
          <mxCell vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;fillColor=#DCEFE3;strokeColor=#247348;fontColor=#247348;fontSize=17;fontStyle=1;">
            <mxGeometry x="60" y="230" width="440" height="42" as="geometry" />
          </mxCell>
