<div class="auth-layout">
  <%= render "scene" %>
  <main class="auth-main">
    <div class="auth-topline"><span class="eyebrow">Рабочее пространство</span><span class="mono">СЕКЦИЯ / <%= registration ? "02" : "01" %></span></div>
    <section class="auth-form-wrap" aria-labelledby="auth-title">
      <span class="section-index">ДОСТУП К СИСТЕМЕ</span>
      <h2 id="auth-title"><%= registration ? "Заявка на доступ" : "С возвращением." %></h2>
      <p class="muted"><%= registration ? "Расскажите, как к вам обращаться. Доступ откроет администратор." : "Войдите, чтобы продолжить работу с каталогом." %></p>
      <form data-action="submit->workspace#<%= registration ? "register" : "login" %>" data-turbo="false" class="form-stack">
        <% if registration %>
          <label class="field">Имя<input name="name" autocomplete="name" required maxlength="120" placeholder="Как к вам обращаться"></label>
        <% end %>
        <label class="field">Электронная почта<input name="email_address" type="email" autocomplete="username" required placeholder="name@company.ru" autocapitalize="none" spellcheck="false"></label>
        <label class="field">Пароль<span class="password-field"><input name="password" type="password" aria-label="Пароль" autocomplete="<%= registration ? "new-password" : "current-password" %>" required placeholder="Введите пароль"><button type="button" class="password-toggle" data-action="workspace#togglePassword" aria-label="Показать пароль" aria-pressed="false">Показать</button></span></label>
        <% if registration %>
          <label class="field">Повторите пароль<input name="password_confirmation" type="password" autocomplete="new-password" required placeholder="Ещё раз"></label>
        <% end %>
        <div class="form-error" role="alert" tabindex="-1" hidden></div>
        <button class="button button--primary button--wide" type="submit"><span><%= registration ? "Отправить заявку" : "Войти в систему" %></span><span aria-hidden="true">↗</span></button>
      </form>
      <p class="auth-switch"><%= registration ? "Уже есть аккаунт?" : "Первый раз здесь?" %> <button class="text-button" data-action="workspace#navigate" data-view="<%= registration ? "login" : "register" %>"><%= registration ? "Войти" : "Подать заявку" %></button></p>
    </section>
    <div class="auth-bottomline"><span class="status-dot"></span> Доступ к каталогу после активации <span class="mono">СЕКЦИЯ © <%= Date.current.year %></span></div>
  </main>
</div>
